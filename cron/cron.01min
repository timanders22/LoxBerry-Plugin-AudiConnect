#!/bin/sh
# Audi Connect - Waechter, minuetlich.
# Startet den Dienst neu, wenn er laufen soll, aber nicht laeuft.
# Die Platzhalter fuer bin- und Log-Ordner setzt der Installer in den
# Befehlszeilen ein; sie stehen deshalb nur dort und nicht in diesem Kommentar.
#
# Seit 0.9.30 (Gruppe 41, Bauvorschrift G2) als ERSTE Anweisung der Waechter der
# Befehlsbruecke: startet sie nach Boot und Update spaetestens nach einer Minute,
# wenn "Befehle ueber MQTT annehmen" gesetzt ist, und haelt sie sonst an
# (befehlsbruecke.php --waechter: misst zustand.json, nie waehrend einer
# Aktualisierung, hoechstens alle 600 s ein Neustart). Kein Start in den
# Hakenskripten. Ausgabe nach /dev/null: die Bruecke protokolliert selbst.
# Der Dienstwaechter schreibt seine Fehlerausgabe seit 0.9.30 nach cron.err neben
# dem Protokoll (Regeln/03, "Der Cron-Eintrag verschluckt seine Fehlerausgabe
# nicht"); erst den Ordner anlegen und die Datei anfassen - log/plugins liegt
# auf der RAM-Platte und kann fehlen.
BBSH="REPLACELBPBINDIR/befehlsbruecke.sh"
[ -f "$BBSH" ] && /bin/bash "$BBSH" waechter >/dev/null 2>&1
mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
touch "REPLACELBPLOGDIR/cron.err" 2>/dev/null
"REPLACELBPBINDIR/dienst.sh" waechter >/dev/null 2>>"REPLACELBPLOGDIR/cron.err"
